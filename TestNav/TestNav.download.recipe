<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads the latest version of TestNav.
JSON_ARCH can be `arm` or `intel`.
    </string>
    <key>Identifier</key>
    <string>com.github.nstrauss.download.TestNav</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>TestNav</string>
        <key>SEARCH_URL</key>
        <string>https://download.testnav.com/installerVersions.json</string>
        <key>JSON_ARCH</key>
        <string>arm</string>
    </dict>
    <key>MinimumVersion</key>
    <string>1.4</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>warning_message</key>
                <string>This recipe is not longer maintained by me. Please use github.com/nfvcsd/recipes</string>
                <key>json_url</key>
                <string>%SEARCH_URL%</string>
                <key>json_key</key>
                <string>mac_%JSON_ARCH%</string>
            </dict>
            <key>Processor</key>
            <string>com.github.nstrauss.SharedProcessors/SimpleJSONParser</string>
        </dict>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>url</key>
                <string>https://download.testnav.com/_testnavinstallers/%json_value%</string>
            </dict>
            <key>Processor</key>
            <string>URLDownloader</string>
        </dict>
        <dict>
            <key>Processor</key>
            <string>DeprecationWarning</string>
        </dict>
        <dict>
            <key>Processor</key>
            <string>EndOfCheckPhase</string>
        </dict>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>input_path</key>
                <string>%pathname%/TestNav.app</string>
                <key>requirement</key>
                <string>identifier "com.pearson.testnav.desktopapp" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = "9EGT93JZWD"</string>
            </dict>
            <key>Processor</key>
            <string>CodeSignatureVerifier</string>
        </dict>
    </array>
</dict>
</plist>