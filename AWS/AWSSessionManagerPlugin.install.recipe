<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Download and install the latest AWS Session Manager plugin package.

DOWNLOAD_ARCH
Use the values between double quotes below for arch specific downloads.
- "_arm64" (default): arm64/Apple silicon
- "" (empty): x86_64/Intel

Note: The AWS package does not create the /usr/local/bin/session-manager-plugin
symlink, so the plugin will not be on PATH and the AWS CLI will not find it.
Create it after install, per AWS documentation:
https://docs.aws.amazon.com/systems-manager/latest/userguide/session-manager-working-with-install-plugin.html#install-plugin-macos-signed
    </string>
    <key>Identifier</key>
    <string>com.github.nstrauss.install.AWSSessionManagerPlugin</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>AWSSessionManagerPlugin</string>
        <key>DOWNLOAD_ARCH</key>
        <string>_arm64</string>
    </dict>
    <key>MinimumVersion</key>
    <string>1.0</string>
    <key>ParentRecipe</key>
    <string>com.github.nstrauss.download.AWSSessionManagerPlugin</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>pkg_path</key>
                <string>%pathname%</string>
            </dict>
            <key>Processor</key>
            <string>Installer</string>
        </dict>
    </array>
</dict>
</plist>
